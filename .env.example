# API 服务配置
# 后端服务基础 URL
EXPO_PUBLIC_API_BASE_URL=http://your-ip-address:port

# Sentry 崩溃监控 DSN（留空则不启用 Sentry）
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# Sentry 构建凭证（release 构建上传 source map / ProGuard mapping 用，在 Sentry 后台 Settings → Account → Auth Tokens 创建）
SENTRY_AUTH_TOKEN=sntryu_your-auth-token
